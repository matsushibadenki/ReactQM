{
  "name": "reactqm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:gpu": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example gpu_probe",
    "test:integration": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example calculation_probe",
    "check:worker": "uv run --project worker --locked python -m reactqm_worker doctor",
    "test:worker": "uv run --project worker --locked python -m unittest discover -s worker/tests",
    "smoke:chemistry": "uv run --project worker --locked python -m reactqm_worker smoke",
    "test:render": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example render_probe",
    "test:catalog": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example catalog_probe",
    "test:queue": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example queue_probe",
    "test:structure-import": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example structure_import_probe",
    "test:window-geometry": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example window_geometry_probe",
    "test:bond-render": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example bond_render_probe",
    "test:settings": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example settings_probe",
    "test:refinement": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example refinement_probe",
    "test:rates": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example rate_probe",
    "test:thermochemistry": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example neb_probe -- --thermochemistry",
    "test:transition": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example neb_probe -- --transition",
    "test:neb": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example neb_probe",
    "test:fields": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example bond_render_probe -- --fields",
    "test:screening": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example settings_probe -- --screening",
    "test:dynamics": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example dynamics_probe",
    "test:solution": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example solution_probe",
    "test:solution-path": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example solution_path_probe",
    "test:stoichiometry": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example stoichiometry_probe",
    "test:mace": "cargo run --manifest-path src-tauri/Cargo.toml --locked --example mace_probe"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
