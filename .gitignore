# JavaScript / Vite
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Tauri: build output includes development apps and installers.
target/
/src-tauri/gen/schemas/

# Local dependency caches (npm, Cargo and uv), including nested caches.
.cache/

# Python Worker: virtual environments, bytecode and generated packaging files.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
/worker/build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local configuration; keep example files available for version control.
.env
.env.*
!.env.example
!.env.*.example

# Local calculation artifacts. Do not ignore scientific fixture extensions
# globally: XYZ, SDF, HDF5 and SQLite files may be intentional test inputs.
artifacts/

# macOS metadata and editor temporary files.
.DS_Store
*.swp
*.swo
*~

# Keep package-lock.json, src-tauri/Cargo.lock, worker/uv.lock,
# worker/.python-version, Tauri capabilities and application icons tracked.

